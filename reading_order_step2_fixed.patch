+        captes, non_captes = [], []
+        for w in restants:
+            (captes if mot_dans_cellule(w, bbox) else non_captes).append(w)
+        if captes:
+            par_encadre[idx] = captes
+        restants = non_captes
+    return par_encadre, restants
